{
  "schema_version": 1,
  "description": "Executable order-policy registry for the nine DPRM host settings.",
  "experiments": [
    {
      "id": "puma",
      "host": "PUMA",
      "upstream": "https://github.com/JaeyeonKim01/PUMA",
      "upstream_commit": "d32992dfd10352de59dd64f4ecb6a2fc7871a301",
      "root_env": "PUMA_ROOT",
      "execution_root": "host",
      "working_subdir": ".",
      "integration_readme": "integrations/puma/README.md",
      "entrypoint": "integrations/puma/overlay/train.py",
      "result_file": "results/artifacts/dmpo_matched_step5000_summary.json",
      "evaluation_unit": "GSM8K question with paired correctness and reveal trace",
      "statistics_command": "python scripts/paired_bootstrap.py --baseline \"$PUMA_CONFIDENCE_JSONL\" --method \"$PUMA_DPRM_JSONL\" --key example_id --value correct --scale 100 --output \"$PUMA_STATS_JSON\"",
      "variants": [
        {
          "id": "random",
          "policy": "random masking",
          "status": "implemented_control",
          "command": "python train.py --cfg yaml_files/tinygsm_baseline.yaml"
        },
        {
          "id": "confidence",
          "policy": "confidence progressive",
          "status": "reported",
          "command": "python train.py --cfg yaml_files/tinygsm_puma.yaml"
        },
        {
          "id": "dprm_confidence",
          "policy": "DPRM with confidence warmup",
          "status": "reported",
          "command": "python train.py --cfg yaml_files/tinygsm_puma_dprm.yaml"
        },
        {
          "id": "dprm_random",
          "policy": "DPRM with random warmup",
          "status": "implemented_control",
          "command": "python train.py --cfg yaml_files/tinygsm_puma_dprm_random.yaml"
        }
      ]
    },
    {
      "id": "dmpo",
      "host": "DMPO",
      "upstream": "https://github.com/yuchen-zhu-zyc/DMPO",
      "upstream_commit": "a521073fe534ddc51a4e02f21d3080cb697c1d97",
      "root_env": "DMPO_ROOT",
      "execution_root": "host",
      "working_subdir": ".",
      "integration_readme": "integrations/dmpo/README.md",
      "entrypoint": "integrations/dmpo/overlay/DMPO/run_paper_dmpo.sh",
      "result_file": "results/paper_results.csv",
      "evaluation_unit": "reasoning example with an ordered Boolean success vector",
      "statistics_command": "python integrations/dmpo/scripts/render_matched_results.py --repro-root /tmp/unused --record-source-map reproducibility/dmpo_record_sources.json --artifact-root \"$DPRM_ARTIFACT_ROOT\" --output results/artifacts/dmpo_matched_step5000_summary.json",
      "variants": [
        {
          "id": "random",
          "policy": "random masking with the host decoder",
          "status": "implemented_control",
          "command": "bash DMPO/run_paper_dmpo.sh all random"
        },
        {
          "id": "confidence",
          "policy": "confidence progressive",
          "status": "reported",
          "command": "bash DMPO/run_paper_dmpo.sh all confidence"
        },
        {
          "id": "dprm_confidence",
          "policy": "DPRM with confidence warmup",
          "status": "reported",
          "command": "bash DMPO/run_paper_dmpo.sh all dprm_confidence"
        },
        {
          "id": "dprm_random",
          "policy": "DPRM with random warmup",
          "status": "implemented_control",
          "command": "bash DMPO/run_paper_dmpo.sh all dprm_random"
        }
      ]
    },
    {
      "id": "prism",
      "host": "Prism",
      "upstream": "https://github.com/viiika/Prism",
      "upstream_commit": "21466a8dcb582ffafc1d218ff74e2c31b664c152",
      "root_env": "PRISM_ROOT",
      "execution_root": "host",
      "working_subdir": "LLaDA2mini/LLaDA2mini_Prism",
      "integration_readme": "integrations/prism/README.md",
      "entrypoint": "integrations/prism/overlay/LLaDA2mini/LLaDA2mini_Prism/scripts/run_gsm8k.sh",
      "result_file": "results/paper_results.csv",
      "evaluation_unit": "GSM8K question with vote, survivor, and NFE records",
      "statistics_command": "python scripts/paired_bootstrap.py --baseline \"$PRISM_CONFIDENCE_JSONL\" --method \"$PRISM_DPRM_JSONL\" --key example_id --value voted_correct --scale 100 --output \"$PRISM_STATS_JSON\"",
      "variants": [
        {
          "id": "random",
          "policy": "random reveal order",
          "status": "implemented_control",
          "command": "ORDER_POLICY=random bash scripts/run_gsm8k.sh"
        },
        {
          "id": "confidence",
          "policy": "confidence reveal order",
          "status": "reported",
          "command": "ORDER_POLICY=confidence bash scripts/run_gsm8k.sh"
        },
        {
          "id": "dprm_confidence",
          "policy": "online DPRM with confidence warmup",
          "status": "reported",
          "command": "ORDER_POLICY=dprm_soft_bon bash scripts/run_gsm8k.sh"
        },
        {
          "id": "dprm_random",
          "policy": "online DPRM with random warmup",
          "status": "implemented_control",
          "command": "ORDER_POLICY=dprm_random bash scripts/run_gsm8k.sh"
        }
      ]
    },
    {
      "id": "dplm",
      "host": "DPLM-2 Bit",
      "upstream": "https://github.com/bytedance/dplm",
      "upstream_commit": "8a2e15e53416b4536f03f79ad1f6f6a9cbd5e19d",
      "root_env": "DPLM_ROOT",
      "execution_root": "host",
      "working_subdir": ".",
      "required_env": [
        "DPLM2_BIT_CHECKPOINT"
      ],
      "integration_readme": "integrations/dplm/README.md",
      "entrypoint": "integrations/dplm/overlay/run/train_dprm_dplm2_bit_650m_fair.sh",
      "result_file": "results/paper_results.csv",
      "evaluation_unit": "shared CAMEO target; generated sample for co-generation",
      "statistics_command": "python scripts/paired_bootstrap.py --baseline \"$DPLM_CONFIDENCE_TARGETS\" --method \"$DPLM_DPRM_TARGETS\" --key target_id --value tm_score --output \"$DPLM_STATS_JSON\"",
      "variants": [
        {
          "id": "random",
          "policy": "host random/default masking",
          "status": "implemented_control",
          "command": "python train.py experiment=dplm2/dprm_dplm_650m trainer.max_steps=5000 model.order.enable=false"
        },
        {
          "id": "confidence",
          "policy": "confidence progressive",
          "status": "reported",
          "command": "python train.py experiment=dplm2/dprm_dplm_650m trainer.max_steps=5000 model.order.train_order_policy=progressive_confidence model.order.decode_order_policy=confidence"
        },
        {
          "id": "dprm_confidence",
          "policy": "weighted-sum DPRM",
          "status": "reported",
          "command": "python train.py experiment=dplm2/dprm_joint_ws_dplm_650m"
        },
        {
          "id": "dprm_tcheby",
          "policy": "Tchebycheff DPRM",
          "status": "reported_development_gate",
          "command": "python train.py experiment=dplm2/dprm_joint_tcheby_dplm_650m"
        }
      ]
    },
    {
      "id": "dcm",
      "host": "DCM",
      "upstream": "https://github.com/sanjukta7/aivc-dcm",
      "upstream_commit": "a2fa8e53578b99ca90df34391862e3ddf810bee5",
      "root_env": "DCM_ROOT",
      "execution_root": "release",
      "working_subdir": ".",
      "integration_readme": "integrations/dcm/README.md",
      "entrypoint": "integrations/dcm/scripts/run_terminal_calibration.sh",
      "result_file": "results/paper_results.csv",
      "evaluation_unit": "held-out cell with four decoded reconstructions",
      "statistics_command": "bash integrations/dcm/scripts/run_terminal_calibration.sh",
      "result_variants": {
        "dprm_recovery": "dprm_confidence",
        "dprm_mae": "dprm_confidence",
        "dprm_balanced": "dprm_confidence",
        "dprm_zero": "dprm_confidence"
      },
      "variants": [
        {
          "id": "random",
          "policy": "random ordered masking",
          "status": "implemented_control",
          "execution_root": "host",
          "working_subdir": ".",
          "command": "python scripts/train_rnaseq.py --config configs/rnaseq_dcm_dentate.yaml"
        },
        {
          "id": "confidence",
          "policy": "confidence progressive on the shared frozen model",
          "status": "reported",
          "command": "RUN_REPLICATION=0 bash integrations/dcm/scripts/run_terminal_calibration.sh"
        },
        {
          "id": "dprm_confidence",
          "policy": "terminal-rollout smooth-Tchebycheff preference DPRM on the shared frozen model",
          "status": "reported",
          "command": "bash integrations/dcm/scripts/run_terminal_calibration.sh"
        },
        {
          "id": "dprm_random",
          "policy": "random-warmup training-time smooth-Tchebycheff control",
          "status": "implemented_control",
          "execution_root": "host",
          "working_subdir": ".",
          "command": "python scripts/train_rnaseq.py --config configs/rnaseq_dprm_multiobjective_dentate.yaml --order_policy dprm_random --dprm_reward_mode reconstruction_tchebycheff --dprm_objective_weights 0.45 0.35 0.20 --dprm_gene_aux_mode predicted_zero"
        }
      ]
    },
    {
      "id": "genmol",
      "host": "GenMol V2",
      "upstream": "https://github.com/NVIDIA-Digital-Bio/genmol",
      "upstream_commit": "add09fc83b7255bd09c797e527c0f4b51f5fb7c1",
      "root_env": "GENMOL_ROOT",
      "execution_root": "release",
      "working_subdir": ".",
      "integration_readme": "integrations/genmol/README.md",
      "entrypoint": "integrations/genmol/scripts/run_preference_sweep.sh",
      "result_file": "results/paper_results.csv",
      "evaluation_unit": "generated molecule or shared fragment-task unit",
      "statistics_command": "python integrations/genmol/overlay/scripts/aggregate_ordering_eval.py --method \"$GENMOL_METHOD_SUMMARIES\" --baseline \"$GENMOL_BASELINE_LABEL\" --output-dir \"$GENMOL_STATS_DIR\"",
      "result_variants": {
        "dprm_qed": "dprm_random",
        "dprm_balanced": "dprm_random",
        "dprm_sa": "dprm_random"
      },
      "variants": [
        {
          "id": "random",
          "policy": "native GenMol order",
          "status": "implemented_control",
          "execution_root": "host",
          "working_subdir": ".",
          "command": "bash scripts/run_ordering_train.sh 0 genmol-native random_mdlm outputs/genmol-native 5000"
        },
        {
          "id": "confidence",
          "policy": "confidence progressive",
          "status": "reported",
          "execution_root": "host",
          "working_subdir": ".",
          "command": "bash scripts/run_ordering_train.sh 0 genmol-confidence confidence outputs/genmol-confidence 5000"
        },
        {
          "id": "dprm_confidence",
          "policy": "confidence-warmup balanced smooth-Tchebycheff control",
          "status": "implemented_control",
          "execution_root": "host",
          "working_subdir": ".",
          "command": "DPRM_REWARD_MODE=molecular_tchebycheff DPRM_OBJECTIVE_WEIGHTS='[0.55,0.45]' DPRM_AUX_MODE=molecular_token_class bash scripts/run_ordering_train.sh 0 genmol-dprm-confidence dprm_confidence outputs/genmol-dprm-confidence 5000"
        },
        {
          "id": "dprm_random",
          "policy": "random-warmup QED/balanced/SA smooth-Tchebycheff preference path",
          "status": "reported",
          "command": "SCALARIZATION=smooth_tchebycheff GPU_LIST=0,1,2 bash integrations/genmol/scripts/run_preference_sweep.sh"
        }
      ]
    },
    {
      "id": "sdpo",
      "host": "SDPO",
