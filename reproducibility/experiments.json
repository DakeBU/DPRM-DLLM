          "command": "LLADA_V_TASK=realworldqa LLADA_V_ORDER=dprm_random_warmup DPRM_LLADAV_TABLE=\"${DPRM_LLADAV_TABLE:?set the table selected by run_realworldqa_protocol.sh}\" bash integrations/llada_v/run_lmms_eval.sh"
