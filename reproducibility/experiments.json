{
  "schema_version": 1,
  "description": "Executable order-policy registry for the nine DPRM host settings.",
  "experiments": [
    {
      "id": "puma",
      "host": "PUMA",
      "upstream": "https://github.com/JaeyeonKim01/PUMA",
      "upstream_commit": "d32992dfd10352de59dd64f4ecb6a2fc7871a301",
      "root_env": "PUMA_ROOT",
      "integration_readme": "integrations/puma/README.md",
      "entrypoint": "integrations/puma/overlay/train.py",
      "result_file": "results/paper_results.csv",
      "variants": [
        {"id": "random", "policy": "random masking", "status": "implemented_control", "command": "python train.py --cfg yaml_files/tinygsm_baseline.yaml"},
        {"id": "confidence", "policy": "confidence progressive", "status": "reported", "command": "python train.py --cfg yaml_files/tinygsm_puma.yaml"},
        {"id": "dprm_confidence", "policy": "DPRM with confidence warmup", "status": "reported", "command": "python train.py --cfg yaml_files/tinygsm_puma_dprm.yaml"},
        {"id": "dprm_random", "policy": "DPRM with random warmup", "status": "implemented_control", "command": "python train.py --cfg yaml_files/tinygsm_puma_dprm_random.yaml"}
      ]
    },
    {
      "id": "dmpo",
      "host": "DMPO",
      "upstream": "https://github.com/yuchen-zhu-zyc/DMPO",
      "upstream_commit": "a521073fe534ddc51a4e02f21d3080cb697c1d97",
      "root_env": "DMPO_ROOT",
      "integration_readme": "integrations/dmpo/README.md",
