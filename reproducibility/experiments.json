      "integration_readme": "integrations/omni_diffusion/README.md",
      "entrypoint": "integrations/omni_diffusion/scripts/generate_four_orders.py",
      "result_file": "results/artifacts/multimodal_summary.json",
      "variants": [
        {"id": "random", "policy": "random visual-token order", "status": "reported", "command": "python scripts/generate_four_orders.py --model-path \"$OMNI_MODEL_PATH\" --image-tokenizer-path \"$OMNI_IMAGE_TOKENIZER_PATH\" --order-policy random --output-dir outputs/random"},
        {"id": "confidence", "policy": "confidence visual-token order", "status": "reported", "command": "python scripts/generate_four_orders.py --model-path \"$OMNI_MODEL_PATH\" --image-tokenizer-path \"$OMNI_IMAGE_TOKENIZER_PATH\" --order-policy progressive_confidence --output-dir outputs/confidence"},
        {"id": "dprm_bon2", "policy": "DPRM-BoN-2 action search", "status": "reported", "command": "python scripts/select_dprm_bon.py --records outputs/action_branches.json --output-dir outputs/dprm_bon --shortlist N2=0.3,0.7"},
        {"id": "dprm_bon4", "policy": "DPRM-BoN-4 action search", "status": "reported", "command": "python scripts/select_dprm_bon.py --records outputs/action_branches.json --output-dir outputs/dprm_bon --shortlist N4=0.15,0.3,0.7,0.85"}
      ]
    },
    {
      "id": "llada_v",
      "host": "LLaDA-V",
      "upstream": "https://github.com/ML-GSAI/LLaDA-V",
      "upstream_commit": "f8b02ce04b09f4f271fe55a3652059a73bbc7a32",
      "model": "https://huggingface.co/GSAI-ML/LLaDA-V",
      "root_env": "LLADA_V_ROOT",
      "prerequisite": "DPRM variants load the table fitted by scripts/build_dprm_table.py on the declared fit interval and selected by scripts/select_controller.py on the development interval.",
      "integration_readme": "integrations/llada_v/README.md",
      "entrypoint": "integrations/llada_v/overlay/host/modeling_llada.py",
      "result_file": "results/artifacts/multimodal_summary.json",
      "variants": [
        {"id": "random", "policy": "random answer-token order", "status": "reported_ai2d", "command": "lmms-eval --model llava_onevision_llada --tasks ai2d --gen_kwargs remasking=random"},
        {"id": "confidence", "policy": "confidence answer-token order", "status": "reported", "command": "lmms-eval --model llava_onevision_llada --tasks ai2d,realworldqa --gen_kwargs remasking=progressive_confidence"},
        {"id": "dprm_confidence", "policy": "format/EOT/position bucket DPRM", "status": "reported", "command": "DPRM_LLADAV_TABLE=outputs/dprm_table.json lmms-eval --model llava_onevision_llada --tasks ai2d,realworldqa --gen_kwargs remasking=dprm_confidence_warmup"},
        {"id": "dprm_random", "policy": "DPRM with random warmup", "status": "reported_ai2d", "command": "DPRM_LLADAV_TABLE=outputs/dprm_table.json lmms-eval --model llava_onevision_llada --tasks ai2d --gen_kwargs remasking=dprm_random_warmup"}
      ]
    }
