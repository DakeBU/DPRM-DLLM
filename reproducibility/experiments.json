          "status": "implemented_control",
          "command": "LLADA_V_TASK=realworldqa LLADA_V_ORDER=random bash integrations/llada_v/run_lmms_eval.sh"
        },
        {
          "id": "confidence",
          "policy": "confidence answer-token order",
          "status": "reported",
          "command": "LLADA_V_TASK=realworldqa LLADA_V_ORDER=progressive_confidence bash integrations/llada_v/run_lmms_eval.sh"
        },
        {
