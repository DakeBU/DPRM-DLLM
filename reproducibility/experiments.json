      "variants": [
        {"id": "random", "policy": "native GenMol order", "status": "reported", "command": "bash scripts/run_ordering_train.sh 0 genmol-native random_mdlm outputs/genmol-native 5000"},
        {"id": "confidence", "policy": "confidence progressive", "status": "reported", "command": "bash scripts/run_ordering_train.sh 0 genmol-confidence confidence outputs/genmol-confidence 5000"},
        {"id": "dprm_confidence", "policy": "weighted multi-objective DPRM", "status": "reported", "command": "DPRM_REWARD_MODE=reconstruction_weighted_sum bash scripts/run_ordering_train.sh 0 genmol-dprm dprm_confidence outputs/genmol-dprm 5000"},
        {"id": "dprm_random", "policy": "random-warmup DPRM", "status": "reported", "command": "bash scripts/run_ordering_train.sh 0 genmol-dprm-random dprm_random outputs/genmol-dprm-random 5000"}
      ]
    },
    {
      "id": "sdpo",
      "host": "SDPO",
      "upstream": "https://github.com/hanjq17/discrete-diffusion-sdpo",
      "upstream_commit": "f244b97b711d598e5d6ed826b342379289b5efb0",
      "root_env": "SDPO_DNA_ROOT",
      "integration_readme": "integrations/sdpo/README.md",
