      "variants": [
        {
          "id": "random",
          "policy": "random visual-position control on the frozen host checkpoint",
          "status": "reported_control",
          "command": "OMNI_ONLINE_INCLUDE_RANDOM=1 bash integrations/omni_diffusion/matched/run_online_action_value_controller.sh"
        },
        {
          "id": "confidence",
          "policy": "Omni negative-entropy position order",
          "status": "reported",
          "command": "bash integrations/omni_diffusion/matched/run_online_action_value_controller.sh"
        },
        {
          "id": "dprm_confidence",
          "policy": "online action-value DPRM over the native action and four confidence-rank strata",
          "status": "reported",
          "command": "OMNI_ONLINE_FIXED_GUIDANCE=8 bash integrations/omni_diffusion/matched/run_online_action_value_controller.sh"
        },
        {
          "id": "dprm_random",
          "policy": "uniform random selection over the same five DPRM action candidates",
          "status": "reported_control",
          "command": "OMNI_ONLINE_FIXED_GUIDANCE=8 bash integrations/omni_diffusion/matched/run_online_action_value_controller.sh"
        }
      ]
    },
    {
      "id": "llada_v",
      "host": "LLaDA-V",
      "upstream": "https://github.com/ML-GSAI/LLaDA-V",
      "upstream_commit": "f8b02ce04b09f4f271fe55a3652059a73bbc7a32",
      "model": "https://huggingface.co/GSAI-ML/LLaDA-V",
      "root_env": "LLADA_V_LMMS_ROOT",
