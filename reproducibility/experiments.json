          "status": "reported",
          "command": "DPRM_PHASE_BINS=1 ORDER_POLICY=progressive RUN_NAME=sdpo-confidence bash scripts/run_sdpo_dna_variant.sh"
        },
        {
          "id": "dprm_confidence",
          "policy": "DPRM with confidence warmup",
          "status": "reported",
          "command": "DPRM_PHASE_BINS=1 ORDER_POLICY=dprm RUN_NAME=sdpo-dprm bash scripts/run_sdpo_dna_variant.sh"
        },
        {
          "id": "dprm_random",
          "policy": "DPRM with random warmup",
          "status": "reported",
          "command": "DPRM_PHASE_BINS=1 ORDER_POLICY=dprm_random RUN_NAME=sdpo-dprm-random bash scripts/run_sdpo_dna_variant.sh"
        }
