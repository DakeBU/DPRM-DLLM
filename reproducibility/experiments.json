      "upstream_commit": "a2fa8e53578b99ca90df34391862e3ddf810bee5",
      "root_env": "DCM_ROOT",
      "integration_readme": "integrations/dcm/README.md",
      "entrypoint": "integrations/dcm/overlay/scripts/train_rnaseq.py",
      "result_file": "results/paper_results.csv",
      "variants": [
        {"id": "random", "policy": "random ordered masking", "status": "reported", "command": "python scripts/train_rnaseq.py --config configs/rnaseq_dcm_dentate.yaml"},
        {"id": "confidence", "policy": "confidence progressive", "status": "reported", "command": "python scripts/train_rnaseq.py --config configs/rnaseq_progressive_dentate.yaml"},
        {"id": "dprm_confidence", "policy": "weighted multi-objective DPRM", "status": "reported", "command": "python scripts/train_rnaseq.py --config configs/rnaseq_dprm_multiobjective_dentate.yaml --dprm_reward_mode reconstruction_weighted_sum --order_policy dprm_confidence"},
        {"id": "dprm_random", "policy": "Tchebycheff multi-objective DPRM", "status": "reported", "command": "python scripts/train_rnaseq.py --config configs/rnaseq_dprm_multiobjective_dentate.yaml --dprm_reward_mode reconstruction_tchebycheff --order_policy dprm_random"}
      ]
    },
    {
      "id": "genmol",
      "host": "GenMol V2",
      "upstream": "https://github.com/NVIDIA-Digital-Bio/genmol",
      "upstream_commit": "add09fc83b7255bd09c797e527c0f4b51f5fb7c1",
      "root_env": "GENMOL_ROOT",
