        {"id": "random", "policy": "random reveal order", "status": "implemented_control", "command": "ORDER_POLICY=random bash scripts/run_gsm8k.sh"},
        {"id": "confidence", "policy": "confidence reveal order", "status": "reported", "command": "ORDER_POLICY=confidence bash scripts/run_gsm8k.sh"},
        {"id": "dprm_confidence", "policy": "online DPRM with confidence warmup", "status": "reported", "command": "ORDER_POLICY=dprm_soft_bon bash scripts/run_gsm8k.sh"},
        {"id": "dprm_random", "policy": "online DPRM with random warmup", "status": "implemented_control", "command": "ORDER_POLICY=dprm_random bash scripts/run_gsm8k.sh"}
      ]
    },
    {
      "id": "dplm",
      "host": "DPLM-2 Bit",
      "upstream": "https://github.com/bytedance/dplm",
      "upstream_commit": "8a2e15e53416b4536f03f79ad1f6f6a9cbd5e19d",
