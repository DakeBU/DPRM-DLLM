    {
      "id": "omni_diffusion",
      "host": "Omni-Diffusion",
      "upstream": "https://github.com/VITA-MLLM/Omni-Diffusion",
      "upstream_commit": "c4f4625f84197a72d556ea00f10e5b2775524252",
      "root_env": "OMNI_ROOT",
      "execution_root": "release",
      "working_subdir": ".",
