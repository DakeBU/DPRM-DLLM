      "result_file": "results/paper_results.csv",
      "variants": [
        {"id": "random", "policy": "random masking", "status": "reported", "command": "LOSS_MASK_SAMPLER=random SAMPLER_REMASKING=random bash DMPO/run_dmpo.sh"},
        {"id": "confidence", "policy": "confidence progressive", "status": "reported", "command": "LOSS_MASK_SAMPLER=progressive LOSS_PROGRESSIVE_ORDER_POLICY=confidence SAMPLER_REMASKING=low_confidence bash DMPO/run_dmpo.sh"},
        {"id": "dprm_confidence", "policy": "DPRM with confidence warmup", "status": "reported", "command": "LOSS_MASK_SAMPLER=progressive LOSS_PROGRESSIVE_ORDER_POLICY=dprm_soft_bon DPRM_WARMUP_POLICY=confidence bash DMPO/run_dmpo.sh"},
        {"id": "dprm_random", "policy": "DPRM with random warmup", "status": "implemented_control", "command": "LOSS_MASK_SAMPLER=progressive LOSS_PROGRESSIVE_ORDER_POLICY=dprm_soft_bon DPRM_WARMUP_POLICY=random bash DMPO/run_dmpo.sh"}
      ]
    },
    {
      "id": "prism",
      "host": "Prism",
      "upstream": "https://github.com/viiika/Prism",
