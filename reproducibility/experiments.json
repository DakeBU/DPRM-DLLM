        {"id": "dprm_random", "policy": "DPRM with random warmup", "status": "implemented_control", "command": "LOSS_MASK_SAMPLER=progressive LOSS_PROGRESSIVE_ORDER_POLICY=dprm_soft_bon DPRM_WARMUP_POLICY=random bash DMPO/run_dmpo.sh"}
