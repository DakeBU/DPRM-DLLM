        "OMNI_IMAGE_TOKENIZER_PATH",
        "OMNI_ONLINE_PROMPT_FILE",
        "OMNI_ONLINE_ROOT",
        "VIRTUAL_ENV"
      ],
      "prerequisite": "Use upstream commit c4f4625, the released step-1000 host checkpoint, and the frozen PartiPrompts split. Development selects guidance; confirmation sets OMNI_ONLINE_FIXED_GUIDANCE=8.",
      "integration_readme": "integrations/omni_diffusion/README.md",
      "entrypoint": "integrations/omni_diffusion/matched/run_online_action_value_controller.sh",
