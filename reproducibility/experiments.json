      "variants": [
        {"id": "random", "policy": "native SDPO", "status": "reported", "command": "ORDER_POLICY=baseline RUN_NAME=sdpo-native bash scripts/run_sdpo_dna_variant.sh"},
        {"id": "confidence", "policy": "confidence progressive", "status": "reported", "command": "ORDER_POLICY=progressive RUN_NAME=sdpo-confidence bash scripts/run_sdpo_dna_variant.sh"},
        {"id": "dprm_confidence", "policy": "DPRM with confidence warmup", "status": "reported", "command": "ORDER_POLICY=dprm RUN_NAME=sdpo-dprm bash scripts/run_sdpo_dna_variant.sh"},
        {"id": "dprm_random", "policy": "DPRM with random warmup", "status": "reported", "command": "ORDER_POLICY=dprm_random RUN_NAME=sdpo-dprm-random bash scripts/run_sdpo_dna_variant.sh"}
      ]
    },
    {
      "id": "omni_diffusion",
      "host": "Omni-Diffusion",
      "upstream": "https://github.com/VITA-MLLM/Omni-Diffusion",
      "upstream_commit": "c4f4625f84197a72d556ea00f10e5b2775524252",
      "root_env": "OMNI_ROOT",
      "required_env": ["OMNI_MODEL_PATH", "OMNI_IMAGE_TOKENIZER_PATH", "AESTHETIC_WEIGHTS"],
