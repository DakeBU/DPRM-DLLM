        {"id": "confidence", "policy": "confidence progressive", "status": "reported", "command": "python train.py experiment=dplm2/dprm_dplm_650m trainer.max_steps=5000 model.order.train_order_policy=progressive_confidence model.order.decode_order_policy=confidence"},
        {"id": "dprm_confidence", "policy": "weighted-sum DPRM", "status": "reported", "command": "python train.py experiment=dplm2/dprm_joint_ws_dplm_650m"},
        {"id": "dprm_tcheby", "policy": "Tchebycheff DPRM", "status": "reported_development_gate", "command": "python train.py experiment=dplm2/dprm_joint_tcheby_dplm_650m"}
      ]
